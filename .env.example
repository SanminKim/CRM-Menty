# Скопируйте в .env и заполните. Файл .env не коммитится в git.

# Домен, на котором будет CRM (A-запись должна указывать на IP сервера)
DOMAIN=crm.example.ru

# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# База данных
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password

# Токен для приёма заявок с лендинга: https://DOMAIN/api/leads/?token=...
LEAD_WEBHOOK_TOKEN=change-me-random-token

# Настройки CRM
TIME_ZONE=Europe/Moscow
CRM_CURRENCY=₽
CRM_STUCK_DAYS=14
BACKUP_KEEP_DAYS=14
