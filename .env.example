# Скопируйте в .env и заполните. Файл .env не коммитится в git.

# Домен, на котором будет CRM (A-запись должна указывать на IP сервера)
DOMAIN=crm.example.ru

# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# База данных
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password

# Токен для приёма заявок с сайта (не короче 16 символов): python -c "import secrets; print(secrets.token_urlsafe(32))"
# Пока здесь значение из примера, приём заявок выключен.
LEAD_WEBHOOK_TOKEN=change-me

# Telegram-бот для заявок и уведомлений. Токен выдаёт @BotFather. Пусто — бот выключен
TELEGRAM_BOT_TOKEN=

# Пароль копии (не короче 12 символов). Если задан и администратор подключил Telegram, бот каждую ночь присылает ему
# зашифрованную копию базы. Запишите пароль отдельно от сервера: без него копию не открыть.
BACKUP_PASSPHRASE=

# Проверка, что CRM работает. Заведите бесплатную проверку на healthchecks.io (период 5 минут, запас 10 минут),
# подключите там Telegram и вставьте сюда её ссылку. Пусто — проверка выключена
HEALTHCHECK_PING_URL=

# Часовой пояс и сколько дней хранить ночные копии базы
TIME_ZONE=Europe/Moscow
BACKUP_KEEP_DAYS=14
